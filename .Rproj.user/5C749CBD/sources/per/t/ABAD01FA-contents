library(dplyr)
library(lubridate)
library(stringr)
library(tidyverse)
library(car)
library(leaps)

data <- read.csv("stage3.csv")

## cols delete 
cols_to_keep <- c("incident_id", "date", "state", "n_killed", "n_injured", "gun_stolen", "n_guns_involved", "participant_age", "participant_gender", "participant_type")
data1 <- subset(data, select = cols_to_keep)

#2017 selection
data2 <- data1 %>% 
  filter(year(date) == 2017)

#rows separation

## rimosso le righe con valori mancanti
count_age <- str_count(data2$participant_age, "\\:")
count_gender <- str_count(data2$participant_gender, "\\:")
count_type <- str_count(data2$participant_type, "\\:")

count <- count_age == count_gender &
  count_gender == count_type & count_age >= 1

data3 <- data2[count, ]

## separare le righe
clean_data <- function(column) {
  column <- strsplit(column, "\\|\\|") %>%
    lapply(function(x) gsub("^\\d+::", "", x)) %>%
    sapply(function(x) paste(x, collapse = "||"))
  return(column)
}

data3$participant_gender <- clean_data(data3$participant_gender)
data3$participant_age <- clean_data(data3$participant_age)
data3$participant_type <- clean_data(data3$participant_type)

gender_df <- data3 %>%
  separate_rows(participant_gender, sep = "\\|\\|")

age_df <- data3 %>%
  separate_rows(participant_age, sep = "\\|\\|")

type_df <- data3 %>%
  separate_rows(participant_type, sep = "\\|\\|")

final_df <- cbind(gender_df, age_df[, -1], type_df[, -1])

data4 <- final_df[c(1:7,9,17,28)]


## aggiungo colonna somma
data4$total_victims <- data4$n_killed + data4$n_injured

## creo dataset con solo sospetti e solo vittime
data5 <- data4 %>%
  filter(participant_type != "Victim")

data6 <- data4 %>%
  filter(participant_type == "Victim")


#######################################

# Manipolazione dei dati
data5_manipulated <- data5 %>%
  # Calcola la media delle età dei partecipanti per ciascun incident_id
  group_by(incident_id) %>%
  mutate(avg_age = mean(as.numeric(participant_age))) %>%
  # Assegna il genere in base alla presenza di "male" e/o "female"
  mutate(gender = ifelse("Male" %in% participant_gender & "Female" %in% participant_gender, "mixed",
                         ifelse("Male" %in% participant_gender, "Male",
                                ifelse("Female" %in% participant_gender, "Female", NA)))) %>%
  # Aggiungi una colonna con il numero di partecipanti
  mutate(num_participants = n()) %>%
  # Rimuovi le colonne temporanee create per il calcolo
  select(-c(participant_age, participant_gender, participant_type))

library(dplyr)

# Assume 'data5_manipulated' come il tuo dataframe manipolato
data6 <- data5_manipulated %>%
  distinct(incident_id, .keep_all = TRUE)

